{
  "name": "@shadowmap/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "cd ../../apps/web && prisma generate --schema ../../packages/db/prisma/schema.prisma",
    "push": "cd ../../apps/web && prisma db push --schema ../../packages/db/prisma/schema.prisma",
    "migrate": "cd ../../apps/web && prisma migrate dev --schema ../../packages/db/prisma/schema.prisma",
    "studio": "cd ../../apps/web && prisma studio --schema ../../packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@shadowmap/types": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.6.0",
    "typescript": "^5"
  }
}
