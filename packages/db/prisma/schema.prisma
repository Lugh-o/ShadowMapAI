generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model PointFeature {
  id               String           @id @default(cuid())
  city             String
  neighborhood     String
  lat              Float
  lng              Float
  location         Unsupported("geometry(Point, 4326)")?
  heatLevel        String
  shadeLevel       String
  issueType        String
  description      String
  priority         String
  moderationStatus String           @default("pending")
  submittedBy      String?
  submittedAt      DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([city])
  @@index([moderationStatus])
  @@index([priority])
}

model HeatZone {
  id          String   @id @default(cuid())
  city        String
  name        String
  coordinates Json
  intensity   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
}

model VegetationEstimate {
  id                  String   @id @default(cuid())
  regionId            String
  regionName          String
  city                String
  vegetationCoverage  Float
  ndviMean            Float?
  ndviMax             Float?
  treeCountEstimate   Int?
  cellSize            Float?
  satelliteDate       DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([city])
  @@index([regionId])
}

model PriorityScore {
  id                  String   @id @default(cuid())
  regionId            String
  regionName          String
  city                String
  score               Float
  vegetationCoverage  Float
  heatIntensity       Float
  populationDensity   Float
  citizenReports      Int
  calculatedAt        DateTime @default(now())

  @@index([city])
  @@index([regionId])
  @@unique([regionId, calculatedAt])
}

model NativeSpecies {
  id                String   @id @default(cuid())
  commonName        String
  scientificName    String
  family            String
  climate           Json
  soilType          Json
  treeSize          String
  shadeProduction   String
  droughtTolerance  String
  description       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([family])
}

model AssistantConversation {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GeminiDailyUsage {
  id    String   @id @default(cuid())
  date  DateTime @unique @db.Date
  count Int      @default(0)
}
