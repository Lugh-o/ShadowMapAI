# Deixe vazio localmente. No GitHub Pages de projeto use /ShadowMapAI.
# NEXT_PUBLIC_BASE_PATH=

# URL pública usada em links/metadados (opcional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
