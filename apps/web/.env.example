# ---------------------------------------------------------------------------
# ShadowMap AI — variáveis de ambiente (exemplo)
# Copie para .env. Nunca commite o .env real.
#
# Esta demonstração visual NÃO exige login, banco de dados nem chave de API
# para o mapa. Ela usa OpenStreetMap como camada base.
# ---------------------------------------------------------------------------

# URL pública usada em links/metadados (opcional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco (opcional; a demonstração atual não lê nem grava no banco)
DATABASE_URL=

# Integrações antigas (não usadas pela demonstração atual)
# GOOGLE_AI_API_KEY=
# GEMINI_MODEL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_SECRET=
