# ---------------------------------------------------------------------------
# ShadowMap AI — variáveis de ambiente (exemplo)
# Copie para .env e preencha. Nunca commite o .env real.
# ---------------------------------------------------------------------------

# Banco (PostgreSQL + PostGIS)
DATABASE_URL=

# Auth.js
AUTH_SECRET=            # gerar com: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=       # opcional (login com Google)
GOOGLE_CLIENT_SECRET=   # opcional (login com Google)

# Assistente (Gemini)
GOOGLE_AI_API_KEY=
GEMINI_MODEL=           # confirmar com: pnpm --filter @shadowmap/web check:gemini
ASSISTANT_USER_DAILY_LIMIT=30
ASSISTANT_DAILY_LIMIT=300

# Moderação / piloto
ADMIN_EMAILS=           # e-mails separados por vírgula; vazio = ninguém acessa /admin
PILOT_REFS=bruno,vitoria,davi,joao,lucas,pedro,gustavo,caio,mariana
POINTS_PER_USER_PER_HOUR=10
GEO_BBOX=-13.10,-38.75,-12.45,-38.15

# Interface
NEXT_PUBLIC_SHOW_SIMULATED_DEFAULT=false

# Rate limit em memória (melhor esforço para leitura pública)
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000
